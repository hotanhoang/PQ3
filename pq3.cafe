    eq rk(intruDeriveCK(S, RK0, ES0, MS0, SID), A, B, SID2) = rk(S, A, B, SID2) .
    eq ck(intruDeriveCK(S, RK0, ES0, MS0, SID), A, B, SID2) = ck(S, A, B, SID2) .
    eq ns(intruDeriveCK(S, RK0, ES0, MS0, SID), A, B, SID2) = ns(S, A, B, SID2) .
    eq nr(intruDeriveCK(S, RK0, ES0, MS0, SID), A, B, SID2) = nr(S, A, B, SID2) .
    eq peerPKS(intruDeriveCK(S, RK0, ES0, MS0, SID)) = peerPKS(S) .
    eq selfSKS(intruDeriveCK(S, RK0, ES0, MS0, SID)) = selfSKS(S) .
    eq leakscr(intruDeriveCK(S, RK0, ES0, MS0, SID)) = leakscr(S) .
    ceq knl(intruDeriveCK(S, RK0, ES0, MS0, SID)) = kdf-ck(RK0, ES0, MS0, SID) || knl(S) if c-intruDeriveCK(S, RK0, ES0, MS0, SID) .
    ceq intruDeriveCK(S, RK0, ES0, MS0, SID) = S if not c-intruDeriveCK(S, RK0, ES0, MS0, SID) .

    -- 22. capability of intruder to derive chain key when the root key, ecdh share, and mlk share are all in the intruder's knowledge
    op intruDeriveInitCK : Sys ECDHK-ShareS MLK-ShareS SessId -> Sys {constr}
    op c-intruDeriveInitCK : Sys ECDHK-ShareS MLK-ShareS SessId -> Bool
    eq c-intruDeriveInitCK(S, ES0, MS0, SID) =
        (
         zero-rk \in knl(S) and 
         ES0 \in knl(S) and
         MS0 \in knl(S)) .
    eq usedSK(intruDeriveInitCK(S, ES0, MS0, SID)) = usedSK(S) .
    eq usedSID(intruDeriveInitCK(S, ES0, MS0, SID)) = usedSID(S) .
    eq usedRM(intruDeriveInitCK(S, ES0, MS0, SID)) = usedRM(S) .
    eq nw(intruDeriveInitCK(S, ES0, MS0, SID)) = nw(S) .
    eq idsS(intruDeriveInitCK(S, ES0, MS0, SID)) = idsS(S) .
    eq time(intruDeriveInitCK(S, ES0, MS0, SID)) = time(S) .
    eq rk(intruDeriveInitCK(S, ES0, MS0, SID), A, B, SID2) = rk(S, A, B, SID2) .
    eq ck(intruDeriveInitCK(S, ES0, MS0, SID), A, B, SID2) = ck(S, A, B, SID2) .
    eq ns(intruDeriveInitCK(S, ES0, MS0, SID), A, B, SID2) = ns(S, A, B, SID2) .
    eq nr(intruDeriveInitCK(S, ES0, MS0, SID), A, B, SID2) = nr(S, A, B, SID2) .
    eq peerPKS(intruDeriveInitCK(S, ES0, MS0, SID)) = peerPKS(S) .
    eq selfSKS(intruDeriveInitCK(S, ES0, MS0, SID)) = selfSKS(S) .
    eq leakscr(intruDeriveInitCK(S, ES0, MS0, SID)) = leakscr(S) .
    ceq knl(intruDeriveInitCK(S, ES0, MS0, SID)) = kdf-ck(zero-rk, ES0, MS0, SID) || knl(S) if c-intruDeriveInitCK(S, ES0, MS0, SID) .
    ceq intruDeriveInitCK(S, ES0, MS0, SID) = S if not c-intruDeriveInitCK(S, ES0, MS0, SID) .

    -- 23. capability of intruder to derive new chain key and message key when the chain key is in the intruder's knowledge
    op intruDeriveMsgK : Sys ChainK -> Sys {constr}
    op c-intruDeriveMsgK : Sys ChainK -> Bool
    eq c-intruDeriveMsgK(S, CK) =
        (CK \in knl(S) and
         not (CK = noChainK)) .
    eq usedSK(intruDeriveMsgK(S, CK)) = usedSK(S) .
    eq usedSID(intruDeriveMsgK(S, CK)) = usedSID(S) .
    eq usedRM(intruDeriveMsgK(S, CK)) = usedRM(S) .
    eq nw(intruDeriveMsgK(S, CK)) = nw(S) .
    eq idsS(intruDeriveMsgK(S, CK)) = idsS(S) .
    eq time(intruDeriveMsgK(S, CK)) = time(S) .
    eq rk(intruDeriveMsgK(S, CK), A, B, SID2) = rk(S, A, B, SID2) .
    eq ck(intruDeriveMsgK(S, CK), A, B, SID2) = ck(S, A, B, SID2) .
    eq ns(intruDeriveMsgK(S, CK), A, B, SID2) = ns(S, A, B, SID2) .
    eq nr(intruDeriveMsgK(S, CK), A, B, SID2) = nr(S, A, B, SID2) .
    eq peerPKS(intruDeriveMsgK(S, CK)) = peerPKS(S) .
    eq selfSKS(intruDeriveMsgK(S, CK)) = selfSKS(S) .
    eq leakscr(intruDeriveMsgK(S, CK)) = leakscr(S) .
    ceq knl(intruDeriveMsgK(S, CK)) = mk-sym(CK) || knl(S) if c-intruDeriveMsgK(S, CK) .
    ceq intruDeriveMsgK(S, CK) = S if not c-intruDeriveMsgK(S, CK) .

    -- 24. intruder compromise chain key
    op intruComChainK : Sys ChainK -> Sys {constr}
    op c-intruComChainK : Sys ChainK -> Bool
    eq c-intruComChainK(S, CK) = not(CK \in leakscr(S)) .
    eq usedSK(intruComChainK(S, CK)) = usedSK(S) .
    eq usedSID(intruComChainK(S, CK)) = usedSID(S) .
    eq usedRM(intruComChainK(S, CK)) = usedRM(S) .
    eq nw(intruComChainK(S, CK)) = nw(S) .
    eq idsS(intruComChainK(S, CK)) = idsS(S) .
    ceq time(intruComChainK(S, CK)) = s(time(S)) if c-intruComChainK(S, CK) .
    eq rk(intruComChainK(S, CK), A, B, SID2) = rk(S, A, B, SID2) .
    eq ck(intruComChainK(S, CK), A, B, SID2) = ck(S, A, B, SID2) .
    eq ns(intruComChainK(S, CK), A, B, SID2) = ns(S, A, B, SID2) .
    eq nr(intruComChainK(S, CK), A, B, SID2) = nr(S, A, B, SID2) .
    eq peerPKS(intruComChainK(S, CK)) = peerPKS(S) .
    eq selfSKS(intruComChainK(S, CK)) = selfSKS(S) .
    ceq leakscr(intruComChainK(S, CK)) = ckNPair(CK, time(S)) CK leakscr(S) if  c-intruComChainK(S, CK) .
    ceq knl(intruComChainK(S, CK)) = ckNPair(CK, time(S)) || CK || knl(S) if c-intruComChainK(S, CK) .
    ceq intruComChainK(S, CK) = S if not c-intruComChainK(S, CK) .

    -- 25. intruder compromise message key
    op intruComMsgK : Sys MsgK -> Sys {constr}
    op c-intruComMsgK : Sys MsgK -> Bool
    eq c-intruComMsgK(S, MK) = not(MK \in leakscr(S)) .
    eq usedSK(intruComMsgK(S, MK)) = usedSK(S) .
    eq usedSID(intruComMsgK(S, MK)) = usedSID(S) .
    eq usedRM(intruComMsgK(S, MK)) = usedRM(S) .
    eq nw(intruComMsgK(S, MK)) = nw(S) .
    eq idsS(intruComMsgK(S, MK)) = idsS(S) .
    ceq time(intruComMsgK(S, MK)) = s(time(S)) if c-intruComMsgK(S, MK) .
    eq rk(intruComMsgK(S, MK), A, B, SID2) = rk(S, A, B, SID2) .
    eq ck(intruComMsgK(S, MK), A, B, SID2) = ck(S, A, B, SID2) .
    eq ns(intruComMsgK(S, MK), A, B, SID2) = ns(S, A, B, SID2) .
    eq nr(intruComMsgK(S, MK), A, B, SID2) = nr(S, A, B, SID2) .
    eq peerPKS(intruComMsgK(S, MK)) = peerPKS(S) .
    eq selfSKS(intruComMsgK(S, MK)) = selfSKS(S) .
    ceq leakscr(intruComMsgK(S, MK)) = mkNPair(MK, time(S)) MK leakscr(S) if c-intruComMsgK(S, MK) .
    ceq knl(intruComMsgK(S, MK)) = mkNPair(MK, time(S)) || MK || knl(S) if c-intruComMsgK(S, MK) .
    ceq intruComMsgK(S, MK) = S if not c-intruComMsgK(S, MK) .

    -- 26. capability of intruder to decrypt a symmetric message if it knows the exact message key used to encrypt it
    op intruDecMsg : Sys MsgK RawMsg -> Sys {constr}
    op c-intruDecMsg : Sys MsgK RawMsg -> Bool
    eq c-intruDecMsg(S, MK, RM) =
        (
            senc(MK, RM) \in knl(S) and
            RM \in usedRM(S) and
            not(RM \in knl(S)) and
            MK \in knl(S)
        ) .
    eq usedSK(intruDecMsg(S, MK, RM)) = usedSK(S) .
    eq usedSID(intruDecMsg(S, MK, RM)) = usedSID(S) .
    eq usedRM(intruDecMsg(S, MK, RM)) = usedRM(S) .
    eq nw(intruDecMsg(S, MK, RM)) = nw(S) .
    eq idsS(intruDecMsg(S, MK, RM)) = idsS(S) .
    eq time(intruDecMsg(S, MK, RM)) = time(S) .
    eq rk(intruDecMsg(S, MK, RM), P, Q, SID) = rk(S, P, Q, SID) .
    eq ck(intruDecMsg(S, MK, RM), P, Q, SID) = ck(S, P, Q, SID) .
    eq ns(intruDecMsg(S, MK, RM), P, Q, SID) = ns(S, P, Q, SID) .
    eq nr(intruDecMsg(S, MK, RM), P, Q, SID) = nr(S, P, Q, SID) .
    eq peerPKS(intruDecMsg(S, MK, RM)) = peerPKS(S) .
    eq selfSKS(intruDecMsg(S, MK, RM)) = selfSKS(S) .
    eq leakscr(intruDecMsg(S, MK, RM)) = leakscr(S) .
    ceq knl(intruDecMsg(S, MK, RM)) =  RM || knl(S) if c-intruDecMsg(S, MK, RM) .
    ceq intruDecMsg(S, MK, RM) = S if not c-intruDecMsg(S, MK, RM) .
}