    eq leakscr(intruGetPubInfo(S, P)) = leakscr(S) .
    eq knl(intruGetPubInfo(S, P)) = (P || knl(S)) .

    -- 18. capability of intruder to fake init message
    op fkInitMsg : Sys Prin Prin SessId ECDHK-Cipher MLK-Cipher ECDHK-PublicK MLK-PublicK RawMsg KeyHash -> Sys {constr}
    op c-fkInitMsg : Sys Prin Prin SessId ECDHK-Cipher MLK-Cipher ECDHK-PublicK MLK-PublicK RawMsg KeyHash -> Bool
    eq c-fkInitMsg(S, A, B, SID, C1, C2, EPK, MPK, RM, H) = (C1 \in knl(S) and C2 \in knl(S) and EPK \in knl(S) and MPK  \in knl(S) and H \in knl(S) and not(RM \in usedRM(S))) .
    eq usedSK(fkInitMsg(S, A, B, SID, C1, C2, EPK, MPK, RM, H)) = usedSK(S) .
    eq usedSID(fkInitMsg(S, A, B, SID, C1, C2, EPK, MPK, RM, H)) = usedSID(S) .
    ceq usedRM(fkInitMsg(S, A, B, SID, C1, C2, EPK, MPK, RM, H)) = RM usedRM(S) if c-fkInitMsg(S, A, B, SID, C1, C2, EPK, MPK, RM, H) .
    ceq nw(fkInitMsg(S, A, B, SID, C1, C2, EPK, MPK, RM, H)) =
        (msg(intru, A, B,
                mkInitBody(intru, B, SID, C1, C2, EPK, MPK, ns(S, A, B, SID), ienc(mk-sym(ck(S, A, B, SID)), RM), H),
                time(S)),
            nw(S))
    if c-fkInitMsg(S, A, B, SID, C1, C2, EPK, MPK, RM, H) .
    eq idsS(fkInitMsg(S, A, B, SID, C1, C2, EPK, MPK, RM, H)) = idsS(S) .
    eq time(fkInitMsg(S, A, B, SID, C1, C2, EPK, MPK, RM, H)) = s(time(S)) .
    eq rk(fkInitMsg(S, A, B, SID, C1, C2, EPK, MPK, RM, H), P, Q, SID2) = rk(S, P, Q, SID2) .
    eq ck(fkInitMsg(S, A, B, SID, C1, C2, EPK, MPK, RM, H), P, Q, SID2) = ck(S, P, Q, SID2) .
    eq ns(fkInitMsg(S, A, B, SID, C1, C2, EPK, MPK, RM, H), P, Q, SID2) = ns(S, P, Q, SID2) .
    eq nr(fkInitMsg(S, A, B, SID, C1, C2, EPK, MPK, RM, H), P, Q, SID2) = nr(S, P, Q, SID2) .
    eq peerPKS(fkInitMsg(S, A, B, SID, C1, C2, EPK, MPK, RM, H)) = peerPKS(S) .
    eq selfSKS(fkInitMsg(S, A, B, SID, C1, C2, EPK, MPK, RM, H)) = selfSKS(S) .
    eq leakscr(fkInitMsg(S, A, B, SID, C1, C2, EPK, MPK, RM, H)) = leakscr(S) .
    eq knl(fkInitMsg(S, A, B, SID, C1, C2, EPK, MPK, RM, H)) = knl(S) .
    ceq fkInitMsg(S, A, B, SID, C1, C2, EPK, MPK, RM, H) = S if not c-fkInitMsg(S, A, B, SID, C1, C2, EPK, MPK, RM, H) .

    -- 19. capability of intruder to fake asym message
    op fkMsg : Sys Prin Prin SessId ECDHK-Cipher MLK-Cipher ECDHK-SecretK MLK-SecretK RawMsg -> Sys {constr}
    op c-fkMsg : Sys Prin Prin SessId ECDHK-Cipher MLK-Cipher ECDHK-SecretK MLK-SecretK RawMsg -> Bool
    eq c-fkMsg(S, A, B, SID, C1, C2, ESK, MSK, RM) = (C1 \in knl(S) and C2 \in knl(S) and ESK \in knl(S) and MSK  \in knl(S)) .
    eq usedSK(fkMsg(S, A, B, SID, C1, C2, ESK, MSK, RM)) = usedSK(S) .
    eq usedSID(fkMsg(S, A, B, SID, C1, C2, ESK, MSK, RM)) = usedSID(S) .
    eq usedRM(fkMsg(S, A, B, SID, C1, C2, ESK, MSK, RM)) = usedRM(S) .
    ceq nw(fkMsg(S, A, B, SID, C1, C2, ESK, MSK, RM)) =
        (msg(intru, A, B,
            mkAsymBody(
                A, B, SID,
                ns(S, A, B, SID),
                ar-ct-ecdh-send(S, A, B, SID, ESK),
                ar-ct-mlk-send(S, A, B, SID, MSK),
                ecdhk-keygen(ESK),
                mlk-keygen(MSK),
                aenc(mk-sym(
                    ar-ck(
                        rk(S, A, B, SID),
                        ar-ss-ecdh-send(S, A, B, SID, ESK),
                        ar-ss-mlk-send(S, A, B, SID, MSK),
                        SID
                    )
                ), RM)
            ),
            time(S)),
        nw(S))
    if c-fkMsg(S, A, B, SID, C1, C2, ESK, MSK, RM) .
    eq idsS(fkMsg(S, A, B, SID, C1, C2, ESK, MSK, RM)) = idsS(S) .
    eq time(fkMsg(S, A, B, SID, C1, C2, ESK, MSK, RM)) = s(time(S)) .
    eq rk(fkMsg(S, A, B, SID, C1, C2, ESK, MSK, RM), P, Q, SID2) = rk(S, P, Q, SID2) .
    eq ck(fkMsg(S, A, B, SID, C1, C2, ESK, MSK, RM), P, Q, SID2) = ck(S, P, Q, SID2) .
    eq ns(fkMsg(S, A, B, SID, C1, C2, ESK, MSK, RM), P, Q, SID2) = ns(S, P, Q, SID2) .
    eq nr(fkMsg(S, A, B, SID, C1, C2, ESK, MSK, RM), P, Q, SID2) = nr(S, P, Q, SID2) .
    eq peerPKS(fkMsg(S, A, B, SID, C1, C2, ESK, MSK, RM)) = peerPKS(S) .
    eq selfSKS(fkMsg(S, A, B, SID, C1, C2, ESK, MSK, RM)) = selfSKS(S) .
    eq leakscr(fkMsg(S, A, B, SID, C1, C2, ESK, MSK, RM)) = leakscr(S) .
    eq knl(fkMsg(S, A, B, SID, C1, C2, ESK, MSK, RM)) = knl(S) .
    ceq fkMsg(S, A, B, SID, C1, C2, ESK, MSK, RM) = S if not c-fkMsg(S, A, B, SID, C1, C2, ESK, MSK, RM) .

    -- 20. capability of intruder when previous root key, ecdh share, and mlk share are all in the intruder's knowledge
    op intruDeriveRootK : Sys RootK ECDHK-ShareS MLK-ShareS SessId -> Sys {constr}
    op c-intruDeriveRootK : Sys RootK ECDHK-ShareS MLK-ShareS SessId -> Bool
    eq c-intruDeriveRootK(S, RK0, ES0, MS0, SID) =
        (RK0 \in knl(S) and
         ES0 \in knl(S) and
         MS0 \in knl(S)) .
    eq usedSK(intruDeriveRootK(S, RK0, ES0, MS0, SID)) = usedSK(S) .
    eq usedSID(intruDeriveRootK(S, RK0, ES0, MS0, SID)) = usedSID(S) .
    eq usedRM(intruDeriveRootK(S, RK0, ES0, MS0, SID)) = usedRM(S) .
    eq nw(intruDeriveRootK(S, RK0, ES0, MS0, SID)) = nw(S) .
    eq idsS(intruDeriveRootK(S, RK0, ES0, MS0, SID)) = idsS(S) .
    eq time(intruDeriveRootK(S, RK0, ES0, MS0, SID)) = time(S) .
    eq rk(intruDeriveRootK(S, RK0, ES0, MS0, SID), A, B, SID2) = rk(S, A, B, SID2) .
    eq ck(intruDeriveRootK(S, RK0, ES0, MS0, SID), A, B, SID2) = ck(S, A, B, SID2) .
    eq ns(intruDeriveRootK(S, RK0, ES0, MS0, SID), A, B, SID2) = ns(S, A, B, SID2) .
    eq nr(intruDeriveRootK(S, RK0, ES0, MS0, SID), A, B, SID2) = nr(S, A, B, SID2) .
    eq peerPKS(intruDeriveRootK(S, RK0, ES0, MS0, SID)) = peerPKS(S) .
    eq selfSKS(intruDeriveRootK(S, RK0, ES0, MS0, SID)) = selfSKS(S) .
    eq leakscr(intruDeriveRootK(S, RK0, ES0, MS0, SID)) = leakscr(S) .
    ceq knl(intruDeriveRootK(S, RK0, ES0, MS0, SID)) 
        = kdf-rk(RK0, ES0, MS0, SID) || knl(S) if c-intruDeriveRootK(S, RK0, ES0, MS0, SID) .
    ceq intruDeriveRootK(S, RK0, ES0, MS0, SID) = S if not c-intruDeriveRootK(S, RK0, ES0, MS0, SID) .

    -- 21. capability of intruder to derive chain key when the root key, ecdh share, and mlk share are all in the intruder's knowledge
    op intruDeriveCK : Sys RootK ECDHK-ShareS MLK-ShareS SessId -> Sys {constr}
    op c-intruDeriveCK : Sys RootK ECDHK-ShareS MLK-ShareS SessId -> Bool
    eq c-intruDeriveCK(S, RK0, ES0, MS0, SID) =
