    op intruComECDHKDecaps : Sys ECDHK-SecretK ECDHK-Cipher -> Sys {constr}
    op c-intruComECDHKDecaps : Sys ECDHK-SecretK ECDHK-Cipher -> Bool
    eq c-intruComECDHKDecaps(S, ESK, Ecdhk-Ci) = (Ecdhk-Ci \in knl(S) and ESK \in knl(S)) .
    eq usedSK(intruComECDHKDecaps(S, ESK, Ecdhk-Ci)) = usedSK(S) .
    eq usedSID(intruComECDHKDecaps(S, ESK, Ecdhk-Ci)) = usedSID(S) .
    eq usedRM(intruComECDHKDecaps(S, ESK, Ecdhk-Ci)) = usedRM(S) .
    eq nw(intruComECDHKDecaps(S, ESK, Ecdhk-Ci)) = nw(S) .
    eq idsS(intruComECDHKDecaps(S, ESK, Ecdhk-Ci)) = idsS(S) .    
    eq time(intruComECDHKDecaps(S, ESK, Ecdhk-Ci)) = time(S) .
    eq rk(intruComECDHKDecaps(S, ESK, Ecdhk-Ci), A, B, SID) = rk(S, A, B, SID) .
    eq ck(intruComECDHKDecaps(S, ESK, Ecdhk-Ci), A, B, SID) = ck(S, A, B, SID) .
    eq ns(intruComECDHKDecaps(S, ESK, Ecdhk-Ci), A, B, SID) = ns(S, A, B, SID) .
    eq nr(intruComECDHKDecaps(S, ESK, Ecdhk-Ci), A, B, SID) = nr(S, A, B, SID) .
    eq peerPKS(intruComECDHKDecaps(S, ESK, Ecdhk-Ci)) = peerPKS(S) .
    eq selfSKS(intruComECDHKDecaps(S, ESK, Ecdhk-Ci)) = selfSKS(S) .
    eq leakscr(intruComECDHKDecaps(S, ESK, Ecdhk-Ci)) = leakscr(S) .
    ceq knl(intruComECDHKDecaps(S, ESK, Ecdhk-Ci)) = ecdhk-decaps(Ecdhk-Ci, ESK) || knl(S) if c-intruComECDHKDecaps(S, ESK, Ecdhk-Ci) .
    ceq intruComECDHKDecaps(S, ESK, Ecdhk-Ci) = S if not c-intruComECDHKDecaps(S, ESK, Ecdhk-Ci) .

    -- 16. break ECDH pk, derive private keys from public keys
    op intruBreakECDH : Sys Prin -> Sys {constr}
    op c-intruBreakECDH : Sys Prin -> Bool
    eq c-intruBreakECDH(S,P) = (ECDHK-PubK(P) \in knl(S)) .
    eq usedSK(intruBreakECDH(S, P)) = usedSK(S) .
    eq usedSID(intruBreakECDH(S, P)) = usedSID(S) .
    eq usedRM(intruBreakECDH(S, P)) = usedRM(S) .
    eq nw(intruBreakECDH(S, P)) = nw(S) .
    eq idsS(intruBreakECDH(S, P)) = idsS(S) .
    eq time(intruBreakECDH(S, P)) = time(S) .
    eq rk(intruBreakECDH(S, P), A, B, SID) = rk(S, A, B, SID) .
    eq ck(intruBreakECDH(S, P), A, B, SID) = ck(S, A, B, SID) .
    eq ns(intruBreakECDH(S, P), A, B, SID) = ns(S, A, B, SID) .
    eq nr(intruBreakECDH(S, P), A, B, SID) = nr(S, A, B, SID) .
    eq peerPKS(intruBreakECDH(S, P)) = peerPKS(S) .
    eq selfSKS(intruBreakECDH(S, P)) = selfSKS(S) .
    eq leakscr(intruBreakECDH(S, P)) = leakscr(S) .
    ceq knl(intruBreakECDH(S, P)) = (
        ecdhk-getSecret(ECDHK-PubK(P)) ||
        knl(S)
    ) if c-intruBreakECDH(S, P) .
    ceq intruBreakECDH(S, P) = S if not c-intruBreakECDH(S, P) .

    -- 17. know all publicity information
    op intruGetPubInfo : Sys Prin -> Sys {constr}
    eq usedSK(intruGetPubInfo(S, P)) = usedSK(S) .
    eq usedSID(intruGetPubInfo(S, P)) = usedSID(S) .
    eq usedRM(intruGetPubInfo(S, P)) = usedRM(S) .
    eq nw(intruGetPubInfo(S, P)) = nw(S) .
    eq idsS(intruGetPubInfo(S, P)) = idsS(S) .
    eq time(intruGetPubInfo(S, P)) = time(S) .
    eq rk(intruGetPubInfo(S, P), A, B, SID) = rk(S, A, B, SID) .
    eq ck(intruGetPubInfo(S, P), A, B, SID) = ck(S, A, B, SID) .
    eq ns(intruGetPubInfo(S, P), A, B, SID) = ns(S, A, B, SID) .
    eq nr(intruGetPubInfo(S, P), A, B, SID) = nr(S, A, B, SID) .
