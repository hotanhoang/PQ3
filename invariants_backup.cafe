mod INV {
    pr(PQ3)
    var S  : Sys .
    vars A2 A B : Prin .
    var SID : SessId .
    var ESK : ECDHK-SecretK .
    var EPK : ECDHK-PublicK .
    var MSK : MLK-SecretK .
    var MPK : MLK-PublicK .
    var IB  : InitBody .
    var AB  : AsymBody .
    var N   : Nat .
    var MLK-Ct : MLK-Cipher .
    vars Previous-RK RK : RootK .
    var MSK-SS : MLK-ShareS .
    var ESK-SS : ECDHK-ShareS .
    var CK : ChainK .
    vars MK MK1 MK2 : MsgK .
    vars RM RM1 RM2  : RawMsg .
    var SB  : SymBody .
    var Ecdhk-Ci : ECDHK-Cipher .

    vars ?T : Nat .
    
    -- -- **************************************************************************************************************************************************************************************************
    -- ===> MESSAGE SECRECY
    -- Message secrecy property: if a message is sent by an honest principal and
        -- 1. Message key used to encrypt the message is not leaked, and
        -- 2. The chain key used to derive the message key is not leaked, and
        -- 3. The recipent's long term identity key before the message was sent is not leaked, and
        -- 4. ML-KEM shared secret key used to derive the chain key is not leaked 
    -- then the intruder cannot know the message content.

    -- lemma 1 + 2 + 3a
    op messageSe : Sys Prin Prin Prin SessId ECDHK-SecretK MLK-SecretK RootK ChainK RawMsg SymBody Nat -> Bool .
    eq messageSe(S, A2, A, B, SID, ESK, MSK, Previous-RK, CK, RM, SB, N) =
        (
            not (A = intru or B = intru) and
            not (A = B) and
            msg(A2, A, B, SB, N) \in nw(S) and
            validSymBody(A, B, SB) and
            symSid(SB) = SID and
            kdf-ck(Previous-RK, ss-ecdh(B, ESK), ss-mlk(B, MSK), SID) = CK and
            symDec(mkAt(CK, symN(SB)), symCt(SB)) = RM and
            not (RM = noRawMsg) and
            RM \in usedRM(S) and
            
            not (sk(B) \in' leakscr(S)) and
            not (ss-mlk(B, MSK) \in' leakscr(S)) and
            not (ckAt(CK, symN(SB)) \in' leakscr(S)) and
            not (mkAt(CK, symN(SB)) \in' leakscr(S)) and
            not (RM \in leakscr(S)) 
        )
        implies
        (
            not (RM \in knl(S))
        ) .

    -- -- ****************************************************************  **********************************************************************************************************************************
    -- =====> FORWARD SECRECY
    -- for long-term identity key
    op forwardSeID : Sys Prin Prin Prin SessId ECDHK-SecretK MLK-SecretK RootK ChainK RawMsg SymBody Nat -> Bool .
    eq forwardSeID(S, A2, A, B, SID, ESK, MSK, Previous-RK, CK, RM, SB, N) =
        (
            not (A = intru or B = intru) and
            not (A = B) and
            msg(A2, A, B, SB, N) \in nw(S) and
            validSymBody(A, B, SB) and
            symSid(SB) = SID and
            kdf-ck(Previous-RK, ss-ecdh(B, ESK), ss-mlk(B, MSK), SID) = CK and
            symDec(mkAt(CK, symN(SB)), symCt(SB)) = RM and
            not (RM = noRawMsg) and
            RM \in usedRM(S) and

            not (ss-mlk(B, MSK) \in leakscr(S)) and
            not (ckAt(CK, symN(SB)) \in leakscr(S)) and
            not (mkAt(CK, symN(SB)) \in leakscr(S)) and
            not (RM \in leakscr(S)) and
            (sk(B) \in' leakscr(S) implies N < timeLeak(sk(B), leakscr(S)))
        )
        implies
        (
            not (RM \in knl(S))
        ) .


    -- for ML-KEM secret key
    op forwardSeMLK : Sys Prin Prin Prin SessId ECDHK-SecretK MLK-SecretK RootK ChainK RawMsg SymBody Nat -> Bool .
    eq forwardSeMLK(S, A2, A, B, SID, ESK, MSK, Previous-RK, CK, RM, SB, N) =
        (
            not (A = intru or B = intru) and
            not (A = B) and
            msg(A2, A, B, SB, N) \in nw(S) and
            validSymBody(A, B, SB) and
            symSid(SB) = SID and

            kdf-ck(Previous-RK, ss-ecdh(B, ESK), ss-mlk(B, MSK), SID) = CK and
            symDec(mkAt(CK, symN(SB)), symCt(SB)) = RM and
            not (RM = noRawMsg) and
            RM \in usedRM(S) and

            not (ckAt(CK, symN(SB)) \in leakscr(S)) and
            not (mkAt(CK, symN(SB)) \in leakscr(S)) and
            not (RM \in leakscr(S)) and
            not (Previous-RK \in leakscr(S)) and
            not (Previous-RK = zero-rk) and
            (MLK-PriK(B) \in' leakscr(S) implies N < timeLeak(MLK-PriK(B), leakscr(S)))
        )
        implies
        (
            not (RM \in knl(S))
        ) .

