    -- for chain key
    op forwardSeCK : Sys Prin Prin Prin SessId ECDHK-SecretK MLK-SecretK RootK ChainK RawMsg SymBody Nat -> Bool .
    eq forwardSeCK(S, A2, A, B, SID, ESK, MSK, Previous-RK, CK, RM, SB, N) =
    (
        not (A = intru or B = intru) and
        not (A = B) and
        msg(A2, A, B, SB, N) \in nw(S) and
        validSymBody(A, B, SB) and
        symSid(SB) = SID and

        kdf-ck(Previous-RK, ss-ecdh(B, ESK), ss-mlk(B, MSK), SID) = CK and
        symDec(mk-sym(CK), symCt(SB)) = RM and
        not (RM = noRawMsg) and
        RM \in usedRM(S) and

        not (ss-mlk(B, MSK) \in leakscr(S)) and
        not (ckAt(CK, symN(SB)) \in leakscr(S)) and
        not (mkAt(CK, symN(SB)) \in leakscr(S)) and
        not (RM \in leakscr(S)) and
        (ckAt(CK, s(symN(SB))) \in' leakscr(S) implies N < timeLeak(ckAt(CK, s(symN(SB))), leakscr(S))) 
    )
    implies
    (
        not (RM \in knl(S))
    ) .

    -- for message key
    op forwardSeMsg : Sys Prin Prin Prin SessId ECDHK-SecretK MLK-SecretK RootK ChainK RawMsg SymBody Nat -> Bool .
    eq forwardSeMsg(S, A2, A, B, SID, ESK, MSK, Previous-RK, CK, RM, SB, N) =
    (
        not (A = intru or B = intru) and
        not (A = B) and

        msg(A2, A, B, SB, N) \in nw(S) and
        validSymBody(A, B, SB) and
        symSid(SB) = SID and

        kdf-ck(Previous-RK, ss-ecdh(B, ESK), ss-mlk(B, MSK), SID) = CK and
        symDec(mkAt(CK, symN(SB)), symCt(SB)) = RM and
        not (RM = noRawMsg) and
        RM \in usedRM(S) and


        not (ss-mlk(B, MSK) \in leakscr(S)) and
        not (ckAt(CK, symN(SB)) \in leakscr(S)) and
        not (mkAt(CK, symN(SB)) \in leakscr(S)) and
        not (RM \in leakscr(S)) and
        (mkAt(CK, s(symN(SB))) \in' leakscr(S) implies N < timeLeak(mkAt(CK, s(symN(SB))), leakscr(S))) 

    )
    implies
    (
        not (RM \in knl(S))
    ) .


    -- -- **************************************************************************************************************************************************************************************************
    -- =====> POST-COMPROMISE SECURITY

    op postCompSe : Sys Prin Prin Prin SessId ECDHK-SecretK MLK-SecretK RootK ChainK RawMsg SymBody Nat -> Bool .
    eq postCompSe(S, A2, A, B, SID, ESK, MSK, Previous-RK, CK, RM, SB, N) =
        (
            not (A = intru or B = intru) and
            not (A = B) and
            msg(A2, A, B, SB, N) \in nw(S) and
            validSymBody(A, B, SB) and
            symSid(SB) = SID and
            kdf-ck(Previous-RK, ss-ecdh(B, ESK), ss-mlk(B, MSK), SID) = CK and
            symDec(mkAt(CK, symN(SB)), symCt(SB)) = RM and
            not (RM = noRawMsg) and
            RM \in usedRM(S) and

            Previous-RK \in leakscr(S) and

            not (sk(B) \in leakscr(S)) and
            not (ss-mlk(B, MSK) \in leakscr(S)) and
            not (ckAt(CK, symN(SB)) \in leakscr(S)) and
            not (mkAt(CK, symN(SB)) \in leakscr(S)) and
            not (RM \in leakscr(S))
        )
        implies
        (
            not (RM \in knl(S))
        ) .

    -- -- **************************************************************************************************************************************************************************************************
    -- =====> Authenticity
    op auth : Sys Prin Prin Prin SessId RawMsg ChainK SymBody Nat Nat -> Bool .
    eq auth(S, A2, A, B, SID, RM, CK, SB, N, ?T) =
    (
        not (A = intru or B = intru) and
        not (A = B) and
        msg(A2, A, B, SB, N) \in nw(S) and
        validSymBody(A, B, SB) and
        symSid(SB) = SID and
        symDec(mkAt(CK, symN(SB)), symCt(SB)) = RM and
        not (RM = noRawMsg) and
        not (sk(A) \in' leakscr(S))
    )
    implies
    (
        msg(A, A, B, SB, ?T) \in nw(S)
    ) .


    -- no lemma
    -- formal description of the invariant: if a raw message is not used in the protocol, then the intruder cannot know it.
    op inv1 : Sys RawMsg -> Bool .
    eq inv1(S, RM) = not(RM \in usedRM(S)) implies not(RM \in knl(S)) .

    -- no lemma
    -- formal description of the invariant: if a message is sent by an honest principal and this is a real message, then the message content must be in used.
    op inv2a : Sys Prin Prin Prin SessId ECDHK-SecretK MLK-SecretK ChainK RawMsg InitBody Nat -> Bool .
    eq inv2a(S, A2, A, B, SID, ESK, MSK, CK, RM, IB, N) =
        (
            not (A = B) and
            msg(A2, A, B, IB, N) \in nw(S) and
            validInitBody(A, B, IB) and
            initSid(IB) = SID and
            init-ck(ss-ecdh(B, ESK), ss-mlk(B, MSK), SID) = CK and
            initDec(mk-sym(CK), initCt(IB)) = RM and
            not (RM = noRawMsg)
        )
        implies
        (
            RM \in usedRM(S)
        ) .




    -- no lemma
    op inv2 : Sys Prin Prin Prin SessId ECDHK-SecretK MLK-SecretK ChainK RawMsg RootK SymBody Nat -> Bool .
    eq inv2(S, A2, A, B, SID, ESK, MSK, CK, RM, Previous-RK, SB, N) =
        (
            not (A = B) and
            msg(A2, A, B, SB, N) \in nw(S) and
            validSymBody(A, B, SB) and
            symSid(SB) = SID and
            kdf-ck(Previous-RK, ss-ecdh(B, ESK), ss-mlk(B, MSK), SID) = CK and
            symDec(mkAt(CK, symN(SB)), symCt(SB)) = RM and
            not (RM = noRawMsg)
        )
        implies
        (
            RM \in usedRM(S)
        ) .

