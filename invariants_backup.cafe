    op inv3a : Sys Prin Prin Prin SessId ECDHK-SecretK MLK-SecretK RootK ChainK RawMsg SymBody Nat MsgK -> Bool .
    eq inv3a(S, A2, A, B, SID, ESK, MSK, Previous-RK, CK, RM, SB, N, MK2) =
        (
            not (A = intru or B = intru) and
            not (A = B) and
            msg(A2, A, B, SB, N) \in nw(S) and
            validSymBody(A, B, SB) and
            symSid(SB) = SID and
            kdf-ck(Previous-RK, ss-ecdh(B, ESK), ss-mlk(B, MSK), SID) = CK and
            symDec(mkAt(CK, symN(SB)), symCt(SB)) = RM and
            not (RM = noRawMsg) and
            not (RM \in knl(S)) and
            senc(MK2, RM) \in knl(S)
        )
        implies
        (
            MK2 = mkAt(CK, symN(SB))
        ) .

    op inv3c : Sys Prin Prin Prin SymBody Nat MsgK RawMsg -> Bool .
    eq inv3c(S, A2, A, B, SB, N, MK, RM) =
        (
            msg(A2, A, B, SB, N) \in nw(S) and
            symDec(MK, symCt(SB)) = RM and
            not (RM = noRawMsg)
        )
        implies
        (
            RM \in usedRM(S)
        ) .
    op inv3d : Sys MsgK RawMsg -> Bool .
    eq inv3d(S, MK, RM) =
        (
            senc(MK, RM) \in knl(S) and
            not (RM = noRawMsg)
        )
        implies
        (
            RM \in usedRM(S)
        ) .

    -- 

    op inv3b : Sys Prin Prin Prin SessId ECDHK-SecretK MLK-SecretK RootK ChainK SymBody Nat -> Bool .
    eq inv3b(S, A2, A, B, SID, ESK, MSK, Previous-RK, CK, SB, N) =
        (
            not (A = intru or B = intru) and
            not (A = B) and
            msg(A2, A, B, SB, N) \in nw(S) and
            validSymBody(A, B, SB) and
            symSid(SB) = SID and
            kdf-ck(Previous-RK, ss-ecdh(B, ESK), ss-mlk(B, MSK), SID) = CK and
            not (sk(B) \in' leakscr(S)) and
            not (ss-mlk(B, MSK) \in' leakscr(S)) and
            not (ckAt(CK, symN(SB)) \in' leakscr(S)) and
            not (mkAt(CK, symN(SB)) \in' leakscr(S))
        )
        implies
        (
            not (mkAt(CK, symN(SB)) \in knl(S))
        ) .

    op inv3e : Sys Prin Prin SessId ECDHK-SecretK MLK-SecretK RootK ChainK Nat -> Bool .
    eq inv3e(S, A, B, SID, ESK, MSK, Previous-RK, CK, N) =
        (
            not (A = intru or B = intru) and
            not (A = B) and
            kdf-ck(Previous-RK, ss-ecdh(B, ESK), ss-mlk(B, MSK), SID) = CK and
            not (sk(B) \in' leakscr(S)) and
            not (ss-mlk(B, MSK) \in' leakscr(S)) and
            not (ckAt(CK, N) \in' leakscr(S)) and
            not (mkAt(CK, N) \in' leakscr(S))
        )
        implies
        (
            not (mkAt(CK, N) \in knl(S))
        ) .
    -- lemma: 3g
    op inv3f : Sys Prin Prin Prin SessId ECDHK-SecretK MLK-SecretK RootK ChainK SymBody Nat -> Bool .
    eq inv3f(S, A2, A, B, SID, ESK, MSK, Previous-RK, CK, SB, N) =
        (
            not (A = intru or B = intru) and
            not (A = B) and
            msg(A2, A, B, SB, N) \in nw(S) and
            validSymBody(A, B, SB) and
            symSid(SB) = SID and
            kdf-ck(Previous-RK, ss-ecdh(B, ESK), ss-mlk(B, MSK), SID) = CK and
            not (sk(B) \in' leakscr(S)) and
            not (ss-mlk(B, MSK) \in' leakscr(S)) and
            not (ckAt(CK, symN(SB)) \in' leakscr(S))
        )
        implies
        (
            not (ckAt(CK, symN(SB)) \in knl(S))
        ) .

    -- no lemma
    op inv3g : Sys ChainK -> Bool .
    eq inv3g(S, CK) =
        (
            not (CK \in' leakscr(S))
        )
        implies
        (
            not (CK \in knl(S))
        ) .
    


