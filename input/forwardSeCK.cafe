  generate forwardSeCK(S:Sys, A2:Prin, A:Prin, B:Prin, SID:SessId, ESK:ECDHK-SecretK, MSK:MLK-SecretK, Previous-RK:RootK, CK:ChainK, RM:RawMsg, SB:SymBody, N:Nat)
