        ) .

    -- no lemma
    op inv8 : Sys ChainK -> Bool .
    eq inv8(S, CK) =
        (
            not (CK \in' leakscr(S))
        )
        implies
        (
            not (CK \in knl(S))
        ) .

    -- lemma: 8
    op inv9 : Sys Prin Prin Prin SessId ECDHK-SecretK MLK-SecretK RootK ChainK SymBody Nat -> Bool .
