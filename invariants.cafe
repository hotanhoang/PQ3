    op inv7 : Sys Prin Prin Prin SessId ECDHK-SecretK MLK-SecretK RootK ChainK SymBody Nat -> Bool .
    eq inv7(S, A2, A, B, SID, ESK, MSK, Previous-RK, CK, SB, N) =
