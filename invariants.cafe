        ) .

    op inv3g : Sys Prin Prin Prin SessId ECDHK-SecretK MLK-SecretK RootK ChainK SymBody Nat -> Bool .
    eq inv3g(S, A2, A, B, SID, ESK, MSK, Previous-RK, CK, SB, N) =
        (
            not (A = intru or B = intru) and
            not (A = B) and
            msg(A2, A, B, SB, N) \in nw(S) and
            validSymBody(A, B, SB) and
            symSid(SB) = SID and
            kdf-ck(Previous-RK, ss-ecdh(B, ESK), ss-mlk(B, MSK), SID) = CK and
            
            Previous-RK \in leakscr(S) and
            not (sk(B) \in' leakscr(S)) and
            not (ss-mlk(B, MSK) \in' leakscr(S)) and
            not (ckAt(CK, symN(SB)) \in' leakscr(S)) and
            not (mkAt(CK, symN(SB)) \in' leakscr(S))
        )
        implies
        (
            not (mkAt(CK, symN(SB)) \in knl(S))
        ) .

    -- no lemma
    op inv4 : Sys Prin Prin Prin SymBody Nat MsgK RawMsg -> Bool .
    eq inv4(S, A2, A, B, SB, N, MK, RM) =
        (
            msg(A2, A, B, SB, N) \in nw(S) and
            symDec(MK, symCt(SB)) = RM and
            not (RM = noRawMsg)
        )
        implies
        (
            RM \in usedRM(S)
        ) .
    -- no lemma
    op inv5 : Sys MsgK RawMsg -> Bool .
    eq inv5(S, MK, RM) =
        (
            senc(MK, RM) \in knl(S) and
            not (RM = noRawMsg)
        )
        implies
        (
            RM \in usedRM(S)
        ) .
   
    -- lemma: 8
    op inv6 : Sys Prin Prin SessId ECDHK-SecretK MLK-SecretK RootK ChainK Nat -> Bool .
    eq inv6(S, A, B, SID, ESK, MSK, Previous-RK, CK, N) =
        (
            not (A = intru or B = intru) and
            not (A = B) and
            kdf-ck(Previous-RK, ss-ecdh(B, ESK), ss-mlk(B, MSK), SID) = CK and
            not (sk(B) \in' leakscr(S)) and
            not (ss-mlk(B, MSK) \in' leakscr(S)) and
            not (ckAt(CK, N) \in' leakscr(S)) and
            not (mkAt(CK, N) \in' leakscr(S))
        )
        implies
        (
            not (mkAt(CK, N) \in knl(S))
        ) .
