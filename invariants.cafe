        ) .
    -- lemma: 8
    op inv10 : Sys Prin Prin SessId ECDHK-SecretK MLK-SecretK RootK ChainK Nat -> Bool .
    eq inv10(S, A, B, SID, ESK, MSK, Previous-RK, CK, N) =
        (
            not (A = intru or B = intru) and
            not (A = B) and
            kdf-ck(Previous-RK, ss-ecdh(B, ESK), ss-mlk(B, MSK), SID) = CK and
            
            not (ss-mlk(B, MSK) \in' leakscr(S)) and
            not (ckAt(CK, N) \in' leakscr(S)) and
            not (mkAt(CK, N) \in' leakscr(S)) and

            (sk(B) \in' leakscr(S) implies time(S) < timeLeak(sk(B), leakscr(S)))
        )
        implies
        (
            not (mkAt(CK, N) \in knl(S))
        ) .

    -- lemma: 8
    op inv11 : Sys Prin Prin Prin SessId ECDHK-SecretK MLK-SecretK RootK ChainK SymBody Nat -> Bool .
    eq inv11(S, A2, A, B, SID, ESK, MSK, Previous-RK, CK, SB, N) =
        (
            not (A = intru or B = intru) and
            not (A = B) and
            msg(A2, A, B, SB, N) \in nw(S) and
            validSymBody(A, B, SB) and
            symSid(SB) = SID and
            kdf-ck(Previous-RK, ss-ecdh(B, ESK), ss-mlk(B, MSK), SID) = CK and
            
            not (ckAt(CK, symN(SB)) \in' leakscr(S)) and
            not (Previous-RK \in leakscr(S)) and
            (MLK-PriK(B) \in' leakscr(S) implies N < timeLeak(MLK-PriK(B), leakscr(S)))
        )
        implies
        (
            not (ckAt(CK, symN(SB)) \in knl(S))
        ) .
