    -- no lemma
    op inv10 : Sys Prin Prin Prin SymBody Nat MsgK RawMsg -> Bool .
    eq inv10(S, A2, A, B, SB, N, MK, RM) =
        (
            msg(A2, A, B, SB, N) \in nw(S) and
            symDec(MK, symCt(SB)) = RM and
            not (RM = noRawMsg)
        )
        implies
        (
            RM \in usedRM(S)
        ) .
    -- no lemma
    op inv11 : Sys MsgK RawMsg -> Bool .
    eq inv11(S, MK, RM) =
        (
            senc(MK, RM) \in knl(S) and
            not (RM = noRawMsg)
        )
        implies
        (
            RM \in usedRM(S)
        ) .
   
    -- lemma: 14
    op inv12 : Sys Prin Prin SessId ECDHK-SecretK MLK-SecretK RootK ChainK Nat -> Bool .
    eq inv12(S, A, B, SID, ESK, MSK, Previous-RK, CK, N) =
        (
            not (A = intru or B = intru) and
            not (A = B) and
            kdf-ck(Previous-RK, ss-ecdh(B, ESK), ss-mlk(B, MSK), SID) = CK and
            not (sk(B) \in leakscr(S)) and
            not (ss-mlk(B, MSK) \in leakscr(S)) and
            not (ckAt(CK, N) \in leakscr(S)) and
            not (mkAt(CK, N) \in leakscr(S))
        )
        implies
        (
            not (mkAt(CK, N) \in knl(S))
        ) .
    -- lemma: 14
    op inv13 : Sys Prin Prin Prin SessId ECDHK-SecretK MLK-SecretK RootK ChainK SymBody Nat -> Bool .
    eq inv13(S, A2, A, B, SID, ESK, MSK, Previous-RK, CK, SB, N) =
        (
