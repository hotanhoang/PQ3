  op sid : -> SessId .
  eq (r1 \in' leakscr(s)) = false .
  eq (a = b) = false .
  eq (a = intru) = false .
  eq (b = intru) = false .
  eq ck = kdf-ck(previous-rk,(ECDHK-PriK(b) & esk),(MLK-PriK(b) & msk),sid) .
