in pq3.cafe .
in invariants.cafe .

set trace whole on
--> true
open INV .
  op a : -> Prin .
  op a2 : -> Prin .
  op b : -> Prin .
  op ck : -> ChainK .
  op esk : -> ECDHK-SecretK .
  op msk : -> MLK-SecretK .
  op n : -> Nat .
  op previous-rk : -> RootK .
  op r1 : -> Prin .
  op r2 : -> Prin .
  op r3 : -> SessId .
  op r4 : -> ECDHK-Cipher .
  op r5 : -> MLK-Cipher .
  op r6 : -> ECDHK-PublicK .
  op r7 : -> MLK-PublicK .
  op r8 : -> RawMsg .
  op r9 : -> KeyHash .
  op rm : -> RawMsg .
  op s : -> Sys .
  op sb : -> SymBody .
  op sid : -> SessId .
  eq (r4 \in knl(s)) = true .
  eq (r5 \in knl(s)) = true .
  eq (r6 \in knl(s)) = true .
  eq (r7 \in knl(s)) = true .
  eq (r9 \in knl(s)) = true .
  eq (r8 \in usedRM(s)) = true .
