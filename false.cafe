--> false
open INV .
  op a : -> Prin .
  op a2 : -> Prin .
  op b : -> Prin .
  op ck : -> ChainK .
  op esk : -> ECDHK-SecretK .
  op msk : -> MLK-SecretK .
  op n : -> Nat .
  op previous-rk : -> RootK .
  op r1 : -> Prin .
  op r2 : -> Prin .
  op r3 : -> SessId .
  op r4 : -> RawMsg .
  op s : -> Sys .
  op sb : -> SymBody .
  op sid : -> SessId .
  eq (r1 = r2) = false .
  eq (ck(s,r1,r2,r3) = noChainK) = false .
  eq (rk(s,r1,r2,r3) = noRootK) = false .
  eq (r3 \in usedSID(s)) = true .
  eq (r4 \in usedRM(s)) = false .
  eq a = r1 .
  eq a2 = r1 .
  eq b = r2 .
  eq (r1 = intru) = false .
  eq (r2 = intru) = false .
  eq ck = kdf-ck(previous-rk,(ECDHK-PriK(r2) & esk),(MLK-PriK(r2) & msk),sid) .
  eq sb = symBody(r3,ns(s,r1,r2,r3),senc(mk-sym(ck(s,r1,r2,r3)),r4),sign(sk(r1),symSignedData(r1,r2,r3,ns(s,r1,r2,r3),senc(mk-sym(ck(s,r1,r2,r3)),r4)))) .
  eq r3 = sid .
  eq (ck(s,r1,r2,sid) = noChainK) = false .
  eq (rk(s,r1,r2,sid) = noRootK) = false .
  eq (sid \in usedSID(s)) = true .
  eq time(s) = n .
  eq ((MLK-PriK(r2) & msk) \in leakscr(s)) = false .
  eq (ckAt(kdf-ck(previous-rk,(ECDHK-PriK(r2) & esk),(MLK-PriK(r2) & msk),sid),ns(s,r1,r2,sid)) \in leakscr(s)) = false .
  eq (mk-sym(ckAt(kdf-ck(previous-rk,(ECDHK-PriK(r2) & esk),(MLK-PriK(r2) & msk),sid),ns(s,r1,r2,sid))) \in knl(s)) = true .
  eq (mk-sym(ckAt(kdf-ck(previous-rk,(ECDHK-PriK(r2) & esk),(MLK-PriK(r2) & msk),sid),ns(s,r1,r2,sid))) \in leakscr(s)) = false .
  eq (mk-sym(nextck(ckAt(kdf-ck(previous-rk,(ECDHK-PriK(r2) & esk),(MLK-PriK(r2) & msk),sid),ns(s,r1,r2,sid)))) \in' leakscr(s)) = true .
  eq (n < timeLeak(mk-sym(nextck(ckAt(kdf-ck(previous-rk,(ECDHK-PriK(r2) & esk),(MLK-PriK(r2) & msk),sid),ns(s,r1,r2,sid)))),leakscr(s))) = true .
  eq (msg(r1,r1,r2,symBody(sid,ns(s,r1,r2,sid),senc(mk-sym(ck(s,r1,r2,sid)),r4),sign(sk(r1),symSignedData(r1,r2,sid,ns(s,r1,r2,sid),senc(mk-sym(ck(s,r1,r2,sid)),r4)))),n) \in nw(s)) = false .
  red inv3f(s,a2,a,b,sid,esk,msk,previous-rk,ck,sb,n) implies inv3f(send-sym(s,r1,r2,r3,r4),a2,a,b,sid,esk,msk,previous-rk,ck,sb,n) .
close
