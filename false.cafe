--> false
open INV .
  op a : -> Prin .
  op a2 : -> Prin .
  op b : -> Prin .
  op ck : -> ChainK .
  op esk : -> ECDHK-SecretK .
  op msk : -> MLK-SecretK .
  op n : -> Nat .
  op previous-rk : -> RootK .
  op r1 : -> ChainK .
  op s : -> Sys .
  op sb : -> SymBody .
  op sid : -> SessId .
  eq (r1 = noChainK) = false .
  eq (r1 \in knl(s)) = true .
  eq (a = b) = false .
  eq (a = intru) = false .
  eq (b = intru) = false .
  eq ck = kdf-ck(previous-rk,(ECDHK-PriK(b) & esk),(MLK-PriK(b) & msk),sid) .
  eq ckAt(kdf-ck(previous-rk,(ECDHK-PriK(b) & esk),(MLK-PriK(b) & msk),sid),symN(sb)) = r1 .
  eq symSid(sb) = sid .
  eq validSymBody(a,b,sb) = true .
  eq (r1 \in leakscr(s)) = false .
  eq (msg(a2,a,b,sb,n) \in nw(s)) = true .
  eq (mk-sym(r1) \in knl(s)) = false .
  eq (mk-sym(r1) \in leakscr(s)) = false .
  eq (mk-sym(nextck(r1)) \in' leakscr(s)) = true .
  eq ((MLK-PriK(b) & msk) \in leakscr(s)) = false .
  eq (n < timeLeak(mk-sym(nextck(r1)),leakscr(s))) = true .
  red inv3f(s,a2,a,b,sid,esk,msk,previous-rk,ck,sb,n) implies inv3f(intruDeriveMsgK(s,r1),a2,a,b,sid,esk,msk,previous-rk,ck,sb,n) .
close
